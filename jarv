<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>J.A.R.V.I.S.</title>
  <style>
    body { margin: 0; background: #070b14; color: #38bdf8; font-family: monospace; display: flex; flex-direction: column; height: 100vh; }
    header { padding: 16px; border-bottom: 1px solid #0ea5e944; text-align: center; letter-spacing: 3px; font-weight: bold; }
    #chat { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 12px; }
    .msg { max-width: 75%; padding: 12px 16px; border-radius: 8px; line-height: 1.5; white-space: pre-wrap; }
    .user { align-self: flex-end; background: #0284c733; border: 1px solid #38bdf866; color: #e0f2fe; }
    .bot { align-self: flex-start; background: #0f172a; border: 1px solid #0ea5e933; }
    form { display: flex; gap: 10px; padding: 16px; border-top: 1px solid #0ea5e944; background: #050810; }
    input { flex: 1; background: #0f172a; border: 1px solid #38bdf866; color: #e0f2fe; padding: 12px; border-radius: 6px; font-family: monospace; }
    button { background: #0284c7; color: white; border: none; padding: 0 20px; border-radius: 6px; cursor: pointer; font-family: monospace; font-weight: bold; }
  </style>
</head>
<body>
  <header>J.A.R.V.I.S. // ONLINE</header>
  <div id="chat"></div>
  <form id="form">
    <input id="input" placeholder="Enter command..." autocomplete="off" required />
    <button type="submit">SEND</button>
  </form>

  <script>
    // Your key stays in your Chromebook's local browser storage—never uploaded to GitHub
    let apiKey = localStorage.getItem("jarvis_api_key");
    if (!apiKey) {
      apiKey = prompt("Paste your Groq API key (saved only in this browser):");
      if (apiKey) localStorage.setItem("jarvis_api_key", apiKey.trim());
    }

    const chat = document.getElementById("chat");
    const messages = [
      { role: "system", content: "You are JARVIS, a sharp, concise, helpful AI assistant." }
    ];

    function addMsg(text, cls) {
      const div = document.createElement("div");
      div.className = "msg " + cls;
      div.textContent = text;
      chat.appendChild(div);
      chat.scrollTop = chat.scrollHeight;
      return div;
    }

    document.getElementById("form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const input = document.getElementById("input");
      const text = input.value.trim();
      if (!text) return;

      input.value = "";
      addMsg(text, "user");
      messages.push({ role: "user", content: text });
      const botDiv = addMsg("Processing...", "bot");

      try {
        const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
          method: "POST",
          headers: {
            "Authorization": "Bearer " + apiKey,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            model: "llama-3.3-70b-versatile",
            messages: messages
          })
        });
        const data = await res.json();
        const reply = data.choices?.[0]?.message?.content || data.error?.message || "No response.";
        botDiv.textContent = reply;
        messages.push({ role: "assistant", content: reply });
      } catch (err) {
        botDiv.textContent = "Connection error: " + err.message;
      }
    });
  </script>
</body>
</html>
